{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroShoot",
  "version": "0.1.0",
  "identifier": "ai.aeroshoot.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../front-end/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AeroShoot Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "camera_overlay",
        "title": "AeroShoot Camera HUD",
        "width": 240,
        "height": 240,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
